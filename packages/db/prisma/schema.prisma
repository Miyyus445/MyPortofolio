datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Photo {
  id            String   @id @default(uuid())
  title         String
  description   String?
  descriptionId String?
  imageUrl      String
  category      String
  exifData      Json?
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("photos")
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  repoUrl     String?
  demoUrl     String?
  techStack   String[]
  thumbnail   String?
  createdAt   DateTime @default(now())

  @@map("projects")
}

model Experience {
  id           String   @id @default(uuid())
  role         String
  organization String
  period       String
  description  String
  type         String
  createdAt    DateTime @default(now())

  @@map("experiences")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admins")
}